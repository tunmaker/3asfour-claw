{
  "agents": {
    "defaults": {
      "workspace": "/home/openclaw/.openclaw/workspace",
      "model": {
        "primary": "llamacpp/qwen3.8-27b",
        "fallbacks": []
      },
      "models": {
        "llamacpp/qwen3.8-27b": {
          "alias": "qwen"
        }
      },
      "thinkingDefault": "off",
      "reasoningDefault": "off",
      "userTimezone": "Europe/Paris",
      "heartbeat": {
        "every": "0m"
      },
      "pdfModel": {
        "primary": "llamacpp/qwen3.8-27b",
        "fallbacks": []
      },
      "pdfMaxPages": 20,
      "timeoutSeconds": 900,
      "skills": [],
      "skipOptionalBootstrapFiles": [
        "SOUL.md",
        "HEARTBEAT.md"
      ]
    }
  },
  "gateway": {
    "mode": "local",
    "bind": "loopback",
    "port": 18789,
    "auth": {
      "mode": "token",
      "token": {
        "source": "env",
        "provider": "default",
        "id": "OPENCLAW_GATEWAY_TOKEN"
      },
      "rateLimit": {
        "maxAttempts": 5,
        "windowMs": 60000,
        "lockoutMs": 300000,
        "exemptLoopback": false
      }
    },
    "controlUi": {
      "enabled": true
    }
  },
  "cron": {
    "enabled": true,
    "triggers": {
      "enabled": true
    },
    "webhookToken": {
      "source": "env",
      "provider": "default",
      "id": "OPENCLAW_CRON_WEBHOOK_TOKEN"
    },
    "sessionRetention": "24h"
  },
  "hooks": {
    "enabled": true,
    "path": "/hooks",
    "token": {
      "source": "env",
      "provider": "default",
      "id": "OPENCLAW_HOOK_TOKEN"
    },
    "allowRequestSessionKey": true,
    "allowedSessionKeyPrefixes": [
      "autonomy",
      "vision"
    ]
  },
  "meta": {
    "lastTouchedVersion": "2026.8.1"
  },
  "models": {
    "mode": "replace",
    "providers": {
      "llamacpp": {
        "baseUrl": "http://LLAMA_SERVER_IP:8080/v1",
        "apiKey": {
          "source": "env",
          "provider": "default",
          "id": "LLAMACPP_API_KEY"
        },
        "api": "openai-completions",
        "timeoutSeconds": 900,
        "models": [
          {
            "id": "qwen3.8-27b",
            "name": "Qwen3.8 27B IQ4_XS (local, dual Arc)",
            "reasoning": false,
            "input": [
              "text",
              "image"
            ],
            "cost": {
              "input": 0,
              "output": 0,
              "cacheRead": 0,
              "cacheWrite": 0
            },
            "contextWindow": 49152,
            "contextTokens": 40960,
            "maxTokens": 8192,
            "params": {
              "chat_template_kwargs": {
                "enable_thinking": false
              }
            }
          }
        ]
      }
    }
  },
