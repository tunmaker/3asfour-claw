  "mcp": {
    "servers": {
      "grocy": {
        "command": "/home/openclaw/.venvs/grocy-mcp/bin/grocy-mcp",
        "args": [
          "--transport",
          "stdio"
        ]
      },
      "jellyfin": {
        "command": "/home/openclaw/.local/bin/jellyfin-mcp",
        "args": [
          "--disable-destructive",
          "--toolsets",
          "discovery,media,playback"
        ],
        "env": {
          "JELLYFIN_URL": "CHANGEME",
          "JELLYFIN_API_KEY": "CHANGEME"
        }
      }
    }
  },
  "commands": {
    "bash": false
  },
  "memory": {
    "search": {
      "enabled": true,
      "provider": "openai-compatible",
      "fallback": "none",
      "model": "bge-m3",
      "remote": {
        "baseUrl": "http://LLAMA_SERVER_IP:8085/v1",
        "apiKey": {
          "source": "env",
          "provider": "default",
          "id": "LLAMACPP_API_KEY"
        },
        "nonBatchConcurrency": 2,
        "batch": {
          "enabled": false
        }
      },
      "chunking": {
        "tokens": 512,
        "overlap": 64
      },
      "extraPaths": [
        "/home/openclaw/.openclaw/workspace/notes",
        "/home/openclaw/.openclaw/workspace/groceries"
      ],
      "query": {
        "maxResults": 6,
        "minScore": 0.25,
        "hybrid": {
          "enabled": true
        }
      }
    }
  },
  "channels": {
    "whatsapp": {
      "dmPolicy": "allowlist",
      "selfChatMode": true,
      "allowFrom": [
        "+33XXXXXXXXX"
      ],
      "groupPolicy": "allowlist",
      "groupAllowFrom": [
        "*"
      ],
      "groups": {
        "<family-group-jid>@g.us": {}
      }
