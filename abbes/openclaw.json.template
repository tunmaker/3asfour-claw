        {
          "type": "cli",
          "command": "/home/openclaw/bin/whisper-transcribe.sh",
          "args": [
            "{{AttachmentPath}}"
          ],
          "capabilities": [
            "audio"
          ],
          "timeoutSeconds": 300
        }
      ],
      "audio": {
        "enabled": true
      }
    },
    "web": {
      "search": {
        "enabled": false
      },
      "fetch": {
        "enabled": false
      }
    },
    "deny": [
      "web_search",
      "x_search",
      "web_fetch",
      "browser"
    ],
    "elevated": {
      "enabled": false
    },
    "allow": [
      "grocy__shopping_list_view_tool",
      "grocy__entity_create_tool",
      "grocy__shopping_list_remove_tool",
      "grocy__shopping_list_clear_tool",
