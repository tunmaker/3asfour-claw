[Unit]
Description=Select the audio output and pin its level
After=pipewire.service wireplumber.service
Wants=pipewire.service
StartLimitIntervalSec=0

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=%h/bin/abbes-audio-setup.sh
Restart=on-failure
RestartSec=30
TimeoutStartSec=120

[Install]
WantedBy=default.target
