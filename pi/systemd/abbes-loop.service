[Unit]
Description=Abbes voice loop
After=network-online.target pipewire.service openclaw-tunnel.service abbes-audio.service
Wants=network-online.target abbes-audio.service
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=%h/bin/abbes-loop.py
Restart=always
TimeoutStopSec=15

# Restarting fixes a crashed loop. It does not fix a microphone that has stopped
# delivering, and the difference is worth 5s against 300s: when the USB
# controller's isochronous scheduling wedges, every restart is a fresh parecord
# on a dead endpoint, 17s of Vosk loading, and another failed camera grab on the
# bus that is already the problem. Left at a flat 5s this ran 404 times in four
# hours and recovered nothing. It now backs off to five minutes, so a loop that
# cannot fix itself waits quietly instead of holding the bus down.
RestartSec=5
RestartSteps=6
RestartMaxDelaySec=300

[Install]
WantedBy=default.target
