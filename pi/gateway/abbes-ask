#!/usr/bin/env bash
# SSH forced command on the gateway host. Reads a message on stdin, prints the reply.
# Install as /usr/local/bin/abbes-ask, owned by the user that owns ~/.openclaw.
set -uo pipefail

# A forced command runs non-interactively, so the login PATH is not applied.
export PATH="${ABBES_OPENCLAW_BIN:-$HOME/.npm-global/bin}:/usr/local/bin:/usr/bin:/bin"

command -v openclaw >/dev/null || { echo "abbes-ask: openclaw not on PATH ($PATH)" >&2; exit 127; }

# gateway.auth.token is a SecretRef and is not resolved on this command path, so the
# token is read from the env file at runtime. It is never printed and never stored here.
ENV_FILE="${ABBES_OPENCLAW_ENV:-$HOME/.openclaw/openclaw.env}"
if [ -z "${OPENCLAW_GATEWAY_TOKEN:-}" ] && [ -r "$ENV_FILE" ]; then
    tok=$(sed -n 's/^[[:space:]]*OPENCLAW_GATEWAY_TOKEN=[[:space:]]*//p' "$ENV_FILE" | tail -1)
    tok=${tok%\"}; tok=${tok#\"}; tok=${tok%\'}; tok=${tok#\'}
    [ -n "$tok" ] && export OPENCLAW_GATEWAY_TOKEN="$tok"
    unset tok
fi
[ -n "${OPENCLAW_GATEWAY_TOKEN:-}" ] || { echo "abbes-ask: OPENCLAW_GATEWAY_TOKEN not set and not found in $ENV_FILE" >&2; exit 3; }

AGENT="${ABBES_AGENT:-main}"
SESSION_KEY="${ABBES_SESSION_KEY:-voice}"
TIMEOUT="${ABBES_TIMEOUT:-150}"
MAX_BYTES=65536

msg=$(mktemp /tmp/abbes-ask-XXXXXX.txt) || exit 1
chmod 600 "$msg"
trap 'rm -f "$msg"' EXIT

head -c "$MAX_BYTES" > "$msg"
[ -s "$msg" ] && [ -n "$(tr -d '[:space:]' < "$msg")" ] || { echo "abbes-ask: empty message" >&2; exit 2; }

err=$(mktemp /tmp/abbes-ask-err-XXXXXX) || exit 1
trap 'rm -f "$msg" "$err"' EXIT

out=$(openclaw agent \
        --agent "$AGENT" \
        --session-key "$SESSION_KEY" \
        --message-file "$msg" \
        --timeout "$TIMEOUT" \
        --json 2>"$err")
rc=$?

if [ -z "$out" ]; then
    echo "abbes-ask: no output from openclaw (rc=$rc)" >&2
    head -c 2000 "$err" >&2
    exit 1
fi

printf '%s' "$out" | python3 -c '
import json, sys
try:
    d = json.load(sys.stdin)
except json.JSONDecodeError:
    sys.stderr.write("abbes-ask: unparseable JSON envelope\n"); sys.exit(1)
status = d.get("status")
if (status is not None and status != "ok") or d.get("ok") is False:
    sys.stderr.write(f"abbes-ask: status={status} ok={d.get('ok')}\n"); sys.exit(1)
reply = d.get("final")
if not reply:
    for p in d.get("payloads") or []:
        if isinstance(p, dict) and p.get("text"):
            reply = p["text"]; break
if not reply:
    sys.stderr.write(f"abbes-ask: no reply; envelope keys={sorted(d)}\n"); sys.exit(1)
sys.stdout.write(reply.strip())
'
