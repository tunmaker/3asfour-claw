# Copy to ~/.config/voicepi/tunnel.env on the Pi, chmod 600. Never committed.
GATEWAY_SSH_USER=CHANGEME
GATEWAY_HOST=CHANGEME
GATEWAY_PORT=18789
LOCAL_PORT=18789

# The orchestrator listens on loopback beside the gateway, so it rides the same
# tunnel rather than being exposed on the LAN.
ORCH_PORT=18790
ORCH_LOCAL_PORT=18790
