#!/usr/bin/env bash
# Read or change the speaker volume on the voice satellite.
#
# Invoked as an SSH forced command, so the only input is $SSH_ORIGINAL_COMMAND.
# Every value is matched against a fixed pattern before it reaches pactl, and
# the verbs below are the whole of what this key can do on this host.
set -euo pipefail
set -f

export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export PATH=/usr/local/bin:/usr/bin:/bin

CFG="$HOME/.config/voicepi/voicepi.env"
read_cfg() { sed -n "s/^$1=//p" "$CFG" 2>/dev/null | tail -1 | tr -d "\"'"; }

SINK=$(read_cfg SPEAKER_SINK); SINK="${SINK:-@DEFAULT_SINK@}"
STEP=$(read_cfg VOLUME_STEP);  STEP="${STEP:-10}"
MAX=$(read_cfg VOLUME_MAX);    MAX="${MAX:-100}"

current() {
    local v
    v=$(pactl get-sink-volume "$SINK" 2>/dev/null |
        awk 'NR==1 { for (i = 1; i <= NF; i++) if ($i ~ /%$/) { sub(/%/, "", $i); print $i; exit } }')
    [ -n "$v" ] || { echo "no speaker available" >&2; exit 1; }
    echo "$v"
}

apply() {
    local v=$1
    (( v < 0 )) && v=0
    (( v > MAX )) && v=$MAX
    pactl set-sink-volume "$SINK" "$v%"
    pactl set-sink-mute "$SINK" 0
    echo "volume $v%"
}

set -- ${SSH_ORIGINAL_COMMAND:-${*:-get}}

case "${1:-get}" in
    get)    echo "volume $(current)%" ;;
    up)     apply $(( $(current) + STEP )) ;;
    down)   apply $(( $(current) - STEP )) ;;
    set)    [[ "${2:-}" =~ ^[0-9]{1,3}$ ]] || { echo "usage: set <0-$MAX>" >&2; exit 2; }
            apply "$2" ;;
    mute)   pactl set-sink-mute "$SINK" 1; echo "muted" ;;
    unmute) pactl set-sink-mute "$SINK" 0; echo "volume $(current)%" ;;
    *)      echo "usage: get | up | down | set <0-$MAX> | mute | unmute" >&2; exit 2 ;;
esac
