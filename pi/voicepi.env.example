# Copy to ~/.config/voicepi/voicepi.env on the Pi, chmod 600. Never committed.

# --- speech to text ---
WHISPER_URL=CHANGEME
WHISPER_LANGUAGE=ar
WHISPER_TIMEOUT=60
# Tunisian priming vocabulary, sent as whisper's initial_prompt. Edit freely.
# Quote any value containing spaces: this file is sourced by shell scripts too.
WHISPER_PROMPT="شنوة، علاش، برشا، شوية، باهي، توة، قداش، وقتاش، فمّا"

# --- audio devices (pactl list sources/sinks short) ---
# A USB speakerphone is both of these: one device, one cable, and it cancels its
# own output in hardware, which is what lets the microphone stay open while Abbes
# is talking. Point both at it. Names carry the device serial, so they belong
# here on the host and not in the repository.
MIC_SOURCE=CHANGEME
SPEAKER_SINK=CHANGEME

# --- speaker volume (abbes-volume, driven from the gateway) ---
# The agent answers "زيد" with a single `up`, so a step that sounds like nothing
# happened is a step that is too small.
SPEAKER_BOOT_VOLUME=60
VOLUME_STEP=20
VOLUME_MAX=100

# --- voice activity detection ---
# MEASURE THIS PER MICROPHONE AND PER ROOM: record a few seconds of quiet with
# bin/mic-level.sh and put the threshold about 10 dB ABOVE the floor. Too low and
# the VAD never hears silence, so every turn records until VAD_MAX_SECS and the
# decoder spends its search on room noise; too high and short answers are missed.
# Measured on the Jabra SPEAK 510, 11 Sep 2026: floor -45.7 dBFS median, -31.0
# peak, against speech around -20. The webcam microphone this replaced floored at
# -30.1, which left no room between the room and the speech.
VAD_THRESHOLD_DBFS=-36
VAD_SILENCE_SECS=1.5
VAD_MIN_SECS=1.0
# A question can run thirty seconds. Cutting it off mid-sentence is worse
# than transcribing a little silence at the end.
VAD_MAX_SECS=45

# --- barge-in ---
# Interrupting. The microphone hears none of the speaker beside it, so anything
# this loud while Abbes is talking is a person: playback stops, the model is
# aborted, and what you said becomes the next request without repeating it.
# Set clearly above the room floor -- a threshold near it lets a passing lorry
# cut Abbes off. Set BARGE_IN_DBFS=0 to disable.
BARGE_IN_DBFS=-30
BARGE_IN_MIN_SPEECH_SECS=0.35

# --- wake word (Vosk, entirely on this Pi) ---
# Nothing is sent anywhere until the name is recognised here.
WAKE_ENABLED=1
# Written by vosk-install.sh. The loop re-execs itself here to reach Vosk.
WAKE_VOSK_PYTHON=/home/CHANGEME/vosk/bin/python
WAKE_MODEL=/home/CHANGEME/vosk/models/vosk-model-small-ar-tn-0.1-linto
# What the recogniser is allowed to hear. Only words in the model's vocabulary
# work; the rest are dropped. Decoys are loaded from WAKE_DECOYS_FILE.
WAKE_WORDS="عباس|يا عباس|abbes"
# What counts as the name once heard, compared after normalising diacritics,
# alef forms and Latin accents.
WAKE_CANDIDATES="عباس|عبّاس|abbes|abbas|abes"
WAKE_DECOYS_FILE=/home/CHANGEME/.config/voicepi/wake-decoys.txt
# Sensitivity. Edits allowed against each candidate: 0 is strict, 2 is twitchy.
WAKE_FUZZ=1
# The decoder costs about 1s of CPU per 1s of audio on a Pi 3B, so it only runs
# above this level. Set it just above the room's noise floor -- on the previous
# microphone the floor and this gate were the same number, so the decoder ran
# on room noise continuously and the Pi was never idle.
WAKE_GATE_DBFS=-40
WAKE_GATE_HANGOVER_SECS=0.8
# Decoder state is discarded only after this much continuous silence.
WAKE_GATE_IDLE_RESET_SECS=2.0
# Audio kept before the trigger, so "يا عباس قداش عندي مواعيد" is not clipped.
WAKE_PREROLL_SECS=1.2
# Seconds after Abbes finishes speaking during which the name is not needed.
# This is what makes it a conversation rather than a series of commands: say the
# name once, then keep talking. Set to 0 to require the name every time.
WAKE_FOLLOWUP_SECS=45
# The tone used to land in the recording as a clipped transient and start the VAD
# on itself, so Abbes said نعم؟ instead and paid a speech-synthesis round trip to
# do it. The speakerphone's microphone cannot hear the speaker, so the tone is
# inaudible to the recording and is simply the fastest way to say "heard you".
WAKE_TONE=1
# If the name arrives with nothing after it, Abbes says "نعم؟" and listens again,
# so a bare name is never met with silence. Set to 0 to return straight to idle.
WAKE_PROMPT=1
# How long to wait for a request after the name before prompting.
# How long to wait for a request spoken in the same breath as the name,
# before deciding the name arrived alone and answering it.
WAKE_REQUEST_SECS=1.5
# How long to listen after prompting.
# After Abbes answers نعم؟ it holds the microphone open this long waiting
# for you to begin. Take your time; it only stops when you stop speaking.
WAKE_PROMPT_SECS=30
# Trigger timestamps only, for judging false positives. No audio, no transcripts.
WAKE_TALLY_ENABLED=1
WAKE_TALLY=/home/CHANGEME/.local/state/voicepi/wake-events.log

# --- the assistant ---
# echo = loop back the transcript (no gateway needed, for testing)
# ssh  = run GATEWAY_SSH_COMMAND on the gateway host, transcript on stdin, reply on stdout
# http = POST {"message": ...} to GATEWAY_URL
# With an SSH forced command, GATEWAY_SSH_COMMAND is unnecessary — the key runs abbes-ask.
GATEWAY_MODE=echo
GATEWAY_TIMEOUT=90
#GATEWAY_SSH_HOST=CHANGEME
#GATEWAY_SSH_USER=openclaw
#GATEWAY_SSH_KEY=/home/CHANGEME/.ssh/id_ed25519_tunnel
#GATEWAY_URL=http://127.0.0.1:18789/CHANGEME
#GATEWAY_TOKEN=CHANGEME

# --- text to speech ---
# Remote Piper is tried first; local Piper is the fallback and powers the failure phrase.
#PIPER_URL=http://CHANGEME:9091/
# Synthesis measures ~0.2s; a short timeout keeps the fallback quick when the host drops packets.
PIPER_TIMEOUT=5
PIPER_DIR=/home/CHANGEME/piper
PIPER_VOICE_AR=ar_JO-kareem-medium
PIPER_VOICE_FR=fr_FR-siwis-medium
PIPER_VOICE_EN=en_US-lessac-medium

# --- streaming path ---
# When set, the whole turn goes to the orchestrator in one request and speech
# plays as each sentence renders. Comment it out to fall back to the direct
# path (Vosk, then the gateway over SSH, then Piper, then play a whole file).
ORCHESTRATOR_URL=http://127.0.0.1:18790/turn/stream
ORCHESTRATOR_TIMEOUT=180

# --- eyes ---
# SLOW ON PURPOSE. Read this before lowering it.
#
# The camera streams isochronously and so does USB audio, and on a Pi 3B every
# device shares one hub on one dwc_otg controller whose isochronous scheduling is
# the weak point. Polling every 5s wedged that scheduling overnight and took
# *every* microphone on the machine down with it -- the speakerphone and the
# webcam's own mic both returned empty recordings, while Ethernet on the same hub
# kept working. The kernel says so plainly: "FIQ reported NYET. Data may have
# been lost." Only a reboot cleared it.
#
# Presence does not need seconds. Hearing does. 45s costs nothing noticeable.
CAMERA_ENABLED=1
CAMERA_DEVICE=/dev/video0
CAMERA_INTERVAL_SECS=45
# Back off quickly: a wedged camera is pressure on the bus the microphone needs.
CAMERA_WEDGE_AFTER=3
CAMERA_WEDGE_INTERVAL_SECS=600
# The failure count is kept here so a restart does not forget that the camera is
# wedged and start hammering it again from zero.
CAMERA_STATE=/home/CHANGEME/.local/state/voicepi/camera-failures
