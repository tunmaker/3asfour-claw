# Copy to ~/.config/voicepi/voicepi.env on the Pi, chmod 600. Never committed.
# Quote any value containing spaces: this file is sourced by shell scripts too.

# --- audio devices (pactl list sources/sinks short) ---
# A USB speakerphone is both of these. It cancels its own output in hardware, so
# the microphone never hears Abbes. Names carry the device serial.
MIC_SOURCE=CHANGEME
SPEAKER_SINK=CHANGEME
SPEAKER_BOOT_VOLUME=70

# --- the orchestrator, reached through openclaw-tunnel.service ---
ORCHESTRATOR_URL=http://127.0.0.1:18790/turn/stream
ORCHESTRATOR_TIMEOUT=180

# --- recording (bin/mic-level.sh shows the room floor and speech level) ---
VAD_THRESHOLD_DBFS=-36
VAD_SILENCE_SECS=1.2
VAD_MIN_SPEECH_SECS=0.3
# How long after the tone to wait for someone to start talking.
VAD_START_SECS=8
VAD_MAX_SECS=20

# --- wake word (Vosk, entirely on this Pi) ---
# The Tunisian small model recognises the name reliably; it is used for nothing else.
WAKE_ENABLED=1
WAKE_VOSK_PYTHON=/home/CHANGEME/vosk/bin/python
WAKE_MODEL=/home/CHANGEME/vosk/models/vosk-model-small-ar-tn-0.1-linto
WAKE_WORDS="عباس|يا عباس|abbes"
WAKE_CANDIDATES="عباس|عبّاس|abbes|abbas|abes"
WAKE_DECOYS_FILE=/home/CHANGEME/.config/voicepi/wake-decoys.txt
WAKE_FUZZ=1
WAKE_GATE_DBFS=-40
WAKE_GATE_HANGOVER_SECS=0.8
WAKE_GATE_IDLE_RESET_SECS=2.0
WAKE_PREROLL_SECS=1.2
# After a reply, a request started within this many seconds needs no name. 0 disables.
WAKE_FOLLOWUP_SECS=8
# Trigger timestamps only, for bin/wake-tally.sh. No audio, no transcripts.
WAKE_TALLY_ENABLED=1
WAKE_TALLY=/home/CHANGEME/.local/state/voicepi/wake-events.log
