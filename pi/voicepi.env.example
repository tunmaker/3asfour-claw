# Copy to ~/.config/voicepi/voicepi.env on the Pi, chmod 600. Never committed.
WHISPER_URL=CHANGEME
WHISPER_LANGUAGE=ar
WHISPER_TIMEOUT=120

# PipeWire source name or id for the microphone. `pactl list sources short` to find it.
MIC_SOURCE=CHANGEME

# Tunisian priming vocabulary sent to whisper as initial_prompt.
WHISPER_PROMPT=شنوة، علاش، برشا، شوية، باهي، توة، قداش، وقتاش، فمّا
