[Unit]
Description=Abbes voice orchestrator (whisper -> gateway -> Piper)
After=network.target openclaw-gateway.service
Wants=openclaw-gateway.service

[Service]
Type=simple
WorkingDirectory=__HOME__/orchestrator
EnvironmentFile=__HOME__/.openclaw/openclaw.env
Environment=NODE_ENV=production
Environment=ABBES_ORCH_PORT=18790
Environment=ABBES_SESSION_KEY=agent:main:voice
ExecStart=/usr/bin/env sh -c 'STT_URL="$WHISPER_URL" TTS_URL="$PIPER_URL" exec node abbes-orchestrator.mjs'
Restart=on-failure
RestartSec=3

PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=__HOME__/orchestrator

[Install]
WantedBy=default.target
