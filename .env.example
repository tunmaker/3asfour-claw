# Copy to ~/.openclaw/openclaw.env, fill in real values, chmod 600.
# This file is never committed.

# Inference host (OpenAI-compatible chat endpoint)
LLAMACPP_API_KEY=CHANGEME

# Speech-to-text endpoint. Despite the name, this points at the Vosk Derja
# server (port 9092) — whisper-server is retired. The POST is identical.
WHISPER_URL=CHANGEME

# CalDAV
RADICALE_USER=CHANGEME
RADICALE_PASSWORD=CHANGEME
RADICALE_URL=CHANGEME

# Control UI authentication
OPENCLAW_GATEWAY_TOKEN=CHANGEME

# Obsidian vault
ABBES_VAULT_ROOT=CHANGEME
ABBES_VAULT_DIR=CHANGEME
ABBES_VAULT_MOUNT=CHANGEME

# Local runtime data (baby log, reference texts)
ABBES_DATA_DIR=/var/lib/abbes

# Voice satellite: volume control for Abbes's own speech.
# The key is bound to a forced command on that host and can do nothing else there.
ABBES_SPEAKER_SSH=CHANGEME
ABBES_SPEAKER_KEY=CHANGEME

# Backups
ABBES_BACKUP_DEST=CHANGEME
ABBES_BACKUP_MOUNT=CHANGEME

# Weather (Open-Meteo, no key). The home town, in Latin script for the
# geocoder, and optionally how to say it. Coordinates fall back to PRAYER_LAT/LON.
WEATHER_PLACE=CHANGEME
WEATHER_LABEL=CHANGEME

# Prayer times, computed locally
PRAYER_LAT=CHANGEME
PRAYER_LON=CHANGEME
PRAYER_TZ=Europe/Paris
PRAYER_METHOD=tunisia

# Baby journal: the feed amount assumed when none is said and there is no
# previous feed to copy.
BABY_FEED_ML=120

# Where look.sh --photo stores camera shots. Must stay under the service
# user's home: channel delivery only attaches local files from there or /tmp.
#ABBES_CAMERA_DIR=~/.openclaw/camera
