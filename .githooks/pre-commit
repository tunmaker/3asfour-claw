#!/usr/bin/env bash
set -uo pipefail

staged=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$staged" ] && exit 0

fail=0

check() {
    local label="$1" pattern="$2"
    local hits
    hits=$(git diff --cached -U0 -- $staged | grep -nEi "^\+.*${pattern}" || true)
    if [ -n "$hits" ]; then
        echo "BLOCKED: ${label}"
        echo "$hits" | head -5
        fail=1
    fi
}

check "Private IPv4 (192.168.x.x)" "(^|[^0-9.])192\.168\.[0-9]{1,3}\.[0-9]{1,3}([^0-9.]|$)"
check "Private IPv4 (10.x.x.x)" "(^|[^0-9.])10\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}([^0-9.]|$)"
check "Private IPv4 (172.16-31.x.x)" "(^|[^0-9.])172\.(1[6-9]|2[0-9]|3[01])\.[0-9]{1,3}\.[0-9]{1,3}([^0-9.]|$)"
check "Tailscale CGNAT address" "(^|[^0-9])100\.(6[4-9]|[7-9][0-9]|1[01][0-9]|12[0-7])\.[0-9]{1,3}\.[0-9]{1,3}"
check "API key / token assignment" "(api_key|api_secret|auth_token|access_token|secret_key|client_secret|gateway_token)[[:space:]]*[=:][[:space:]]*['\"][^'\"]{8,}"
check "Password in plain text" "(password|passwd|pwd)[[:space:]]*[=:][[:space:]]*['\"][^'\"]{4,}"
check "GitHub token" "gh[pso]_[a-zA-Z0-9]{36}"
check "Private key block" "BEGIN (RSA |OPENSSH |EC |DSA )?PRIVATE KEY"
check "bcrypt hash" "\\\$2[aby]\\\$[0-9]{2}\\\$"
check "Mosque / Mawaqit id" "mawaqit\.net/[a-z0-9-]+"

for f in $staged; do
    case "$f" in
        *.env|.env|*/.env)
            echo "BLOCKED: .env file staged ($f)"; fail=1 ;;
        reference/quran/*)
            echo "BLOCKED: Quran reference text is never committed ($f)"; fail=1 ;;
        data/*)
            echo "BLOCKED: private data directory staged ($f)"; fail=1 ;;
        *.ics|*.csv)
            echo "BLOCKED: calendar/log data staged ($f)"; fail=1 ;;
    esac
done

if [ "$fail" -ne 0 ]; then
    echo
    echo "Commit rejected. Fix the findings above, or bypass deliberately with --no-verify."
    exit 1
fi
exit 0
